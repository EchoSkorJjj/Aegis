# Copy to .env (git-ignored), fill in, then: source .env && terraform init
export TF_CLOUD_ORGANIZATION="your-organization"
# Create this workspace by hand with execution mode Local: bootstrap runs on your machine, with your own AWS
# credentials, because it is what later lets HCP Terraform reach AWS.
export TF_WORKSPACE="aegis-bootstrap"
# Your own AWS sign-in: the profile `aws login --profile aegis-runner` set up (README.md).
export AWS_PROFILE="aegis-runner"
