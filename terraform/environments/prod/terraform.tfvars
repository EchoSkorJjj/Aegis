# Non-secret values for prod (committed). Secrets never go in a tfvars file: they are SSM parameters.
# environment   = "prod"
# aws_region    = "<region>"
# domain_name   = "aegisops.pro"
# vpc_cidr      = "10.50.0.0/16"
# capacity      = "on_demand"
# desired_count = 1
# image_tag     = "<git sha>"
# db_instance_class   = "db.t4g.micro"
# deletion_protection = true
